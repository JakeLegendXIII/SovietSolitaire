<Project>
  <PropertyGroup>
    <GameFramework Condition="'$(GameFramework)' == ''">MonoGame</GameFramework>
    <BaseIntermediateOutputPath>obj\$(GameFramework)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>bin\$(Configuration)\$(GameFramework)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(GameFramework)' == 'MonoGame'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameFramework)' == 'KNI'">
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" PrivateAssets="all" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" PrivateAssets="all" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" PrivateAssets="all" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" PrivateAssets="all" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ValidateGameFramework" BeforeTargets="PrepareForBuild"
          Condition="'$(GameFramework)' != 'MonoGame' and '$(GameFramework)' != 'KNI'">
    <Error Text="GameFramework must be either 'MonoGame' or 'KNI'." />
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>